RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_READ_WINDOW_MS=60000
RATE_LIMIT_READ_MAX_REQUESTS=120
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX_REQUESTS=60
RATE_LIMIT_BATCH_WINDOW_MS=60000
RATE_LIMIT_BATCH_MAX_REQUESTS=20

# Frontend
